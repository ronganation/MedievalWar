        "CompileValidated": {
          "const": false
        },
        "RuntimeValidated": {
          "const": false
        },
        "SaveLoadValidated": {
          "const": false
        },
        "ReplayValidated": {
          "const": false
        },
        "BalanceValidated": {
          "const": false
